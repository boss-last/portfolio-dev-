{
    "name": "boss-last/laravel-enterprise-portal",
    "type": "project",
    "description": "Custom enterprise portal built with Laravel 10 and React.",
    "keywords": ["laravel", "enterprise", "react", "inertia", "rbac"],
    "license": "Proprietary",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "inertiajs/inertia-laravel": "^0.6",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.3",
        "laravel/scout": "^10.5",
        "laravel/tinker": "^2.8",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-permission": "^5.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
